<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cocacola_model_tree" model="ir.ui.view">
        <field name="name">Coca Cola Training Application Tree</field>
        <field name="model">cocacola.model</field>
        <field name="arch" type="xml">
            <tree string="Training Applications">
                <field name="student_namee"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="university_id"/>
                <field name="gender"/>
                <field name="age"/>
            </tree>
        </field>
    </record>
    <record id="view_cocacola_model_form" model="ir.ui.view">
    <field name="name">Coca Cola Training Application Form</field>
    <field name="model">cocacola.model</field>
    <field name="arch" type="xml">
        <form string="Training Application">
            <header>
                <button name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="oe_highlight" />
                <field name="registration_status" widget="statusbar"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="student_namee" placeholder="Enter your name"/>
                    </h1>
                </div>

                <group>
                    <group string="Personal Information">
                        <field name="email" widget="email"/>
                        <field name="password" password="True"/>
                        <field name="phone" widget="phone"/>
                        <field name="age"/>
                        <field name="gender"/>
                    </group>

                    <group string="Education Information">
                        <field name="university_id"/>
                        <field name="attachment"/>
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>

    <record id="action_cocacola_model" model="ir.actions.act_window">
        <field name="name">Training Applications</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cocacola.model</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first training application!
            </p>
            <p>
                Click the create button to add a new training application.
            </p>
        </field>
    </record>


</odoo>