<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="masrtech_project_kanban_view">
            <field name="name">masrtech_project_kanban</field>
            <field name="model">masrtech.project</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <ul>
                                        Name :
                                        <field name="name"/>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.ui.view" id="masrtech_project_form_view">
            <field name="model">masrtech.project</field>
            <field name="arch" type="xml">
                <form string="Projects">
                    <header>
                        <button type="object" name="send_to_students" string="Send to students"
                                class="oe_highlight" invisible="not check_student"/>
                        <button type="object" name="send_to_staff" string="Send to Staff"
                                class="oe_highlight" invisible="check_student"/>
                    </header>
                    <sheet>
                         <style>
                            .o_form_sheet.position-relative{
                            width: 90%;
                            margin: 0 auto;
                            padding: 35px 40px;
                            margin-top: 26px;
                            }
                        </style>
                        <group col="4" colspan="4">
                            <group class="w-50">
                            <field name="name"/>
                            <field name="description"/>
                            <field name="company_id"/>
                            <field name="masrtech_department" widget="many2many_tags"/>
                            <field name="supervisor_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            </group>
                            <group class="w-50">
                            <field name="deadline"/>
                            <field name="email"/>
                            <field name="students" widget="many2many_tags"/>
                            <field name="achievements"/>
                            <field name="challenges"/>
                            <field name="materials_needed"/>
                            <field name="check_student"/>

                        </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="masrtech_project_tree_view">
            <field name="model">masrtech.project</field>
            <field name="arch" type="xml">
                <tree string="Projects">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="action_masrtech_project" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">masrtech.project</field>
            <field name="view_mode">tree,form,search,kanban</field>
        </record>


        <record model="ir.ui.view" id="masrtech_project_type_form_view">
            <field name="model">masrtech.project.type</field>
            <field name="arch" type="xml">
                <form string="Job Opportunities">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="check_rec"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="masrtech_project_type_kanban_view">
            <field name="name">masrtech_project_type_kanban</field>
            <field name="model">masrtech.project.type</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" action="create_project" type="object" sample="1">
                    <field name="name"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <ul>
                                        Name :
                                        <field name="name"/>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    </data>
</odoo>