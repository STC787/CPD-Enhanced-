<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_student_certification_tree" model="ir.ui.view">
        <field name="name">student.certification.tree</field>
        <field name="model">student.certification</field>
        <field name="arch" type="xml">
            <tree string="My Certifications"
                  decoration-success="state=='active'"
                  decoration-muted="state=='expired'">
                <field name="name"/>
                <field name="course_id"/>
                <field name="certification_type"/>
                <!--                <field name="certificate_number"/>-->
                <!--                <field name="expiry_date"/>-->
                <!--                <field name="grade"/>-->
                <!--                <field name="score"/>-->
                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-danger="state=='expired'"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_student_certification_kanban" model="ir.ui.view">
        <field name="name">student.certification.kanban</field>
        <field name="model">student.certification</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="course_id"/>
                <field name="certification_type"/>
                <field name="certification_type"/>
                <field name="expiry_date"/>
                <field name="description"/>
                <field name="certificate_number"/>
                <field name="course_id"/>
                <field name="grade"/>
                <field name="score"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click certificate-kanban">
                            <div class="  o_kanban_card_header text-center" style="margin-block: 20px;">
                                <style>
                                    .card-icon {
                                    width: 60px;
                                    height: 60px;
                                    border-radius: 50%;
                                    display: flex;
                                    align-items: center;
                                    justify-content: center;
                                    margin: 0 auto 1.5rem;
                                    font-size: 2rem;
                                    color: white;
                                    position: relative;
                                    background-color: #65B1FC;
                                    overflow: hidden;
                                    }
                                    .o_kanban_record_right {
                                    display: flex
                                    ;
                                    justify-content: end;
                                    }
                                    <!--                                    .card-icon::before {-->
                                    <!--                                    content: '';-->
                                    <!--                                    position: absolute;-->
                                    <!--                                    top: 0;-->
                                    <!--                                    left: 0;-->
                                    <!--                                    right: 0;-->
                                    <!--                                    bottom: 0;-->
                                    <!--                                    border-radius: 50%;-->
                                    <!--                                    opacity: 0.1;-->

                                    <!--                                    }-->


                                  </style>
                                  <div class="o_primary">

                                      <!--                                        <i t-attf-class="fa #{record.icon_class.raw_value} fa-4x mb-3" style="color: #007bff;"/>-->

                                      <div class="o_kanban_record_right">
                                          <!-- t-attf-class="badge-{{record.state.raw_value == 'active'  or record.state.raw_value == 'expired' }}">-->
                                          <span class="badge"
                                                t-attf-class="badge-{{record.state.raw_value}}">
                                              <field name="state"/>
                                          </span>
                                      </div>
                                      <div class="card-icon user-icon">
                                          <img
                                                  src="/nexus_nms/static/src/images/certificate_solid_icon.svg" alt=""
                                                  style="" class="img-fluid"/>
                                          <field name="certificate_number"/>
                                      </div>

                                      <!--                                        <div class="card-icon user-icon">-->
                                      <!--                                          <span class="o_kanban_record_text text-muted">-->
                                      <!--                                            <i class="fa fa-certificate"/>-->
                                      <!--                                            <field name="certificate_number"/>-->
                                      <!--                                        </span>-->
<!--                                        </div>-->
                                        <h3>
                                            <strong>
                                                <field name="name" class="card-title"/>
                                            </strong>
                                        </h3>
                                    </div>

                                </div>
                            <div class="o_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
<!--                                        <strong class="o_kanban_record_title">-->
<!--                                            <field name="name"/>-->
<!--                                        </strong>-->
<!--                                        <br/>-->
                                        <span class="o_kanban_record_subtitle text-muted">
                                            <field name="certification_type"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div t-if="record.course_id.value">
                                        <i class="fa fa-graduation-cap"/>
                                        <field name="course_id"/>
                                    </div>
                                    <div t-if="record.grade.value" class="mt-1">
                                        <i class="fa fa-star text-warning"/> Grade: <strong><field name="grade"/></strong>
                                        <span t-if="record.score.value"> - <field name="score"/>%</span>
                                    </div>
                                    <div t-if="record.description.value" class="mt-1">
                                        <field name="description" widget="text" limit="80"/>
                                    </div>
                                </div>
<!--                                <div class="o_kanban_record_bottom mt-2">-->
<!--                                    <div class="oe_kanban_bottom_left">-->
<!--                                        <span class="o_kanban_record_text text-muted">-->
<!--                                            <i class="fa fa-certificate"/>-->
<!--                                            <field name="certificate_number"/>-->
<!--                                        </span>-->
<!--                                    </div>-->
<!--                                </div>-->
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="op_course_kanban" model="ir.ui.view">
        <field name="name">student.certification.kanban</field>
        <field name="model">op.course</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="code"/>
                <field name="evaluation_type"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click certificate-kanban">
                            <div class="o_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle text-muted">
                                            <field name="code"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <i class="fa fa-graduation-cap"/>
                                    <field name="evaluation_type"/>


                                    <!--                                    <div t-if="record.grade.value" class="mt-1">-->
                                    <!--                                        <i class="fa fa-star text-warning"/>-->
                                    <!--                                        Grade:-->
                                    <!--                                        <strong>-->
                                    <!--                                            <field name="grade"/>-->
                                    <!--                                        </strong>-->
                                    <!--                                        <span t-if="record.score.value">-<field name="score"/>%-->
                                    <!--                                        </span>-->
                                    <!--                                    </div>-->
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_student_certification_form" model="ir.ui.view">
        <field name="name">student.certification.form</field>
        <field name="model">student.certification</field>
        <field name="arch" type="xml">
            <form string="My Certification">
                <header>
                    <!--                    <button name="action_confirm" type="object" string="Confirm" -->
                    <!--                            class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>-->
                    <!--                    <button name="action_set_expired" type="object" string="Set Expired" -->
                    <!--                            class="btn-secondary" attrs="{'invisible': [('state', '!=', 'active')]}"/>-->
                    <!--                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" -->
                    <!--                            class="btn-secondary" attrs="{'invisible': [('state', '=', 'draft')]}"/>-->
                    <field name="state" widget="statusbar" statusbar_visible="active,expired"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="certificate_number" readonly="1" placeholder="Certificate Number..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Certification Info">
                            <field name="name"/>
                            <field name="course_id"/>
                            <field name="certification_type"/>
                        </group>
                        <!--                        <group string="Certification Details">-->
                        <!--                            <field name="student_ids"/>-->

                        <!--                        </group>-->
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html"
                                   placeholder="Enter certification details, requirements met, etc..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_student_certification_search" model="ir.ui.view">
        <field name="name">student.certification.search</field>
        <field name="model">student.certification</field>
        <field name="arch" type="xml">
            <search string="Search My Certifications">
                <field name="name"/>
                <field name="course_id"/>
                <field name="certification_type"/>
                <field name="state"/>
                <separator/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <separator/>

                <group expand="0" string="Group By">
                    <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Grade" name="group_by_grade" context="{'group_by': 'grade'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_student_certification" model="ir.actions.act_window">
        <field name="name">My Certifications</field>
        <field name="res_model">student.certification</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first student certification!
            </p>
            <p>
                Manage student certifications with different states and track their validity.
                Select students and certifications with grades and courses.
            </p>
        </field>
    </record>

