<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="masrtech_industry_kanban_view">
            <field name="name">industry_kanban</field>
            <field name="model">masrtech.industry</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" action="action_masrtech_factory" type="object" sample="1">
                    <field name="name"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <ul>
                                        Name :
                                        <field name="name"/>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <record model="ir.ui.view" id="masrtech_industry_form_view">
            <field name="model">masrtech.industry</field>
            <field name="arch" type="xml">
                <form string="الصناعة">
                    <sheet>
                          <style>
                            .o_form_sheet.position-relative{
                            width: 90%;
                            margin: 0 auto;
                            padding: 35px 40px;
                            margin-top: 26px;
                            }
                        </style>
                        <group col="4" colspan="4">
                            <group class="w-50">
                            <field name="name"/>
                            <field name="description"/>
                            <field name="sector"/>
                            <field name="founded_date"/>
                            <field name="website"/>
                            <field name="contact_name"/>
                            <field name="contact_email"/>
                            </group>
                            <group class="w-50">
                            <field name="contact_phone"/>
                            <field name="employees"/>
                            <field name="annual_revenue"/>
                            <field name="country"/>
                            <field name="city"/>
                            <field name="state"/>
                            <field name="masrtech_factory" widget="many2many_tags"/>
                            </group>

                        </group>

                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="masrtech_industry_tree_view">
            <field name="model">masrtech.industry</field>
            <field name="arch" type="xml">
                <tree string="الصناعة">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="action_masrtech_industry" model="ir.actions.act_window">
            <field name="name">الصناعة</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">masrtech.industry</field>
            <field name="view_mode">tree,form,search,kanban</field>
        </record>

    </data>
</odoo>