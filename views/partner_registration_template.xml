<odoo>
    <data>
        <template id="key_partner_registration">
            <t t-call="website.layout">
                <div id="wrap">
                    <head>
                        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css"
                              rel="stylesheet"/>
                        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"/>
                        <style>
                            .smallTitle{
                            color: #629ad0;
                            }
                            .bigTitle{
                            background-color: #629ad0;
                            }
                            .partnerRegis input{
                            width:100%;
                            border: unset;
                            box-shadow: 0 0 4px rgba(0,0,0,0.3);
                            border-width: 1px;
                            padding: 10px 8px;
                            border-radius: 4px;
                            }
                            .partnerRegis select{
                            width: 100%;
                            border: unset;
                            box-shadow: 0 0 4px rgba(0,0,0,0.3);
                            border-width: 1px;
                            margin-bottom: 25px;
                            padding: 10px 8px;
                            border-radius: 4px;
                            }
                            .partnerRegis textarea{
                            width: 100%;
                            border: unset;
                            box-shadow: 0 0 4px rgba(0,0,0,0.3);
                            border-width: 1px;
                            margin-bottom: 25px;
                            padding: 10px 8px;
                            border-radius: 4px;
                            min-height: 200px;
                            }
                            .partnerRegis button{
                            height: 40px;
                            background: #629ad0;
                            border-width: 1px;
                            border-radius: 4px;
                            border-color: #629ad0;
                            }
                            .partnerRegis button[type="button"]:not(.remove){
                            height: 35px;
                            background: #3f72a2;
                            border-width: 1px;
                            border-radius: 4px;
                            border-color: #3f72a2;
                            }


                            form.partnerRegis{
                            padding: 30px;
                            margin: auto;
                            direction: rtl;
                            }
                            .partnerRegis label{
                            font-size: 20px;
                            width: 210px;
                            }

                            .partnerRegis select:focus {
                            color: #212529;
                            background-color: #f9f9f9;
                            border: solid 1px black;
                            border-radius: 4px !important;
                            }
                            input[type="radio"]{
                            width:max-content
                            }
                            textarea{
                            border: solid 1px #691617 !important;
                            border-radius: 7px !important;
                            }
                            button.remove {
                            background: transparent;
                            background-image: url(/nexus_nms/static/src/images/bin.svg);
                            border-width: 0px;
                            background-position: center;
                            background-size: 20px;
                            background-repeat: no-repeat;
                            padding: 0;
                            width: 24px;
                            }

                        </style>
                    </head>
                    <body dir="rtl">
                        <form role="form" action="/MASRTECH/key_partner/registration/confirm" method="GET"
                              class="partnerRegis col-md-12 col-lg-9">
                            <img src="/nexus_nms/static/src/images/nexusLogo.png" width="200"
                                 style="margin: auto; display: block;"/>
                            <h3 class="text-center fw-bold smallTitle mt-5">استمارة تسجيل المشاركة للمؤسسات
                            </h3>
                            <h3 class="text-center fw-bold smallTitle mb-3">
                                ملتقى التوظيف الأول - جامعة برج العرب التكنولوجية
                            </h3>
                            <div class="border rounded-3">
                                <h1 class="text-center fw-bold bigTitle text-white  py-2 rounded-top-3 ">بيانات
                                    المؤسسة
                                </h1>
                                <!--                            <label for="fileUpload">logo</label>-->
                                <!--                            <input type="file" id="fileUpload" name="fileUpload"-->
                                <!--                                   required="1" multiple="multiple"/>-->
                                <div class="px-2 py-3">
                                <div class="row g-0">
                                    <div class="col-md-6 px-3">
                                        <div class="d-flex align-items-center">
                                            <label for="company_name" class="fw-bold my-4">اسم المؤسسة:</label>
                                            <input class="my-4 px-2" type="text" id="company_name" name="company_name"
                                                   required="1"/>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <label for="company_address" class="fw-bold my-4">عنوان المؤسسة:</label>
                                            <input class="my-4 px-2" type="text" id="company_address"
                                                   name="company_address"
                                                   required="1"/>
                                        </div>
                                    </div>
                                    <div class="col-md-6 px-3">
                                        <div class="d-flex">
                                            <label for="company_details_name" class="fw-bold my-4">نبذة عن المؤسسة:
                                            </label>
                                            <textarea class="my-4 px-2 border-0" id="company_details_name"
                                                      name="company_details_name" required="1">
                                            </textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="row g-0">
                                    <div class="col-md-6 px-3">
                                        <div class="d-flex align-items-center">
                                            <label for="responsible_person" class="fw-bold my-4">اسم الشخص المسؤول:
                                            </label>
                                            <input class="my-4 px-2" type="text" id="responsible_person"
                                                   name="responsible_person"
                                                   required="1"/>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <label for="email" class="fw-bold my-4">البريد الإلكتروني:</label>
                                            <input class="my-4 px-2" type="email" id="email" name="email" required="1"/>
                                        </div>
                                    </div>
                                    <div class="col-md-6 px-3">
                                        <div class="d-flex align-items-center">
                                            <label for="phone_number" class="fw-bold my-4">رقم الهاتف:</label>
                                            <div class="w-100">
                                                <input class="my-4 px-2" type="tel" id="phone_number"
                                                       name="phone_number"
                                                       required="1"/>
                                                <t t-if="error_message_phone">
                                                    <p style="color: red; margin: 5px 0;">Error:
                                                        <t t-esc="error_message_phone"/>
                                                    </p>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row g-0">
                                    <div class="col-md-6 px-3">
                                        <div class="d-flex flex-column align-items-center">
                                            <h4 class="smallTitle text-center fw-bold">تحديد مجال العمل:</h4>
                                            <select class="my-4 px-2 w-75" name="department" id="department">
                                                <option value="">اختر مجال</option>
                                                <t t-foreach="department" t-as="department">
                                                    <option t-esc="department.name" t-att-value="department.id"
                                                            t-att-selected="str(department.id) == department">
                                                        <t t-esc="department.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6 px-3">
                                        <div>
                                            <h4 class="smallTitle text-center fw-bold">متطلبات المؤسسة:</h4>
                                            <div class="d-flex align-items-center justify-content-center">
                                                <label for="representatives" class="fw-bold my-4 ms-2">عدد ممثلي المؤسسة
                                                    المشاركين:
                                                </label>
                                                <div>
                                                    <input class="my-4 px-2 " type="text" id="representatives"
                                                           name="representatives"
                                                    />
                                                    <t t-if="error_message_representatives">
                                                        <p style="color: red; margin: 5px 0;">Error:
                                                            <t t-esc="error_message_representatives"/>
                                                        </p>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row g-0">
                                    <div class="col-md-12 px-3">
                                        <input type="hidden" name="trainingLineCount" id="trainingLineCount" value="0"/>
                                        <div class="">
                                            <h4 class="smallTitle text-center fw-bold">فرص التدريب المتاحة</h4>
                                            <table id="training_table" class="table">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            <p class="h5 fw-bold text-center">المسمى الوظيفي
                                                            </p>
                                                        </th>
                                                        <th>
                                                            <p class="h5 fw-bold text-center">مدة التدريب</p>
                                                        </th>
                                                        <th>
                                                            <p class="h5 fw-bold text-center">مكان التدريب</p>
                                                        </th>
                                                        <th>
                                                            <p class="h5 fw-bold text-center">عدد المتدربين</p>
                                                        </th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="training_table_body">
                                                    <tr id="training_row_0">
                                                        <td>
                                                            <input type="text" name="training_title_0"
                                                                   id="training_title_0" class="py-3"

                                                            />
                                                        </td>
                                                        <td>
                                                            <input type="text" name="training_duration_0"
                                                                   id="training_duration_0" class="py-3"
                                                            />
                                                        </td>
                                                        <td>
                                                            <input type="text" name="training_location_0"
                                                                   id="training_location_0" class="py-3"
                                                            />
                                                        </td>
                                                        <td>
                                                            <input type="number" name="training_capacity_0"
                                                                   id="training_capacity_0" class="py-3"
                                                            />
                                                        </td>
                                                        <td style="vertical-align:middle;padding: 0;">
                                                            <button type="button" class="remove"
                                                                    onclick="removeTrainingRow(0)">
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <button type="button" id="add_training_line" class="btn text-white">Add
                                                Line
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-md-12 px-3">
                                        <input type="hidden" name="jobLineCount" id="jobLineCount" value="0"/>
                                        <div class="">
                                            <h4 class="smallTitle text-center fw-bold">فرص التوظيف المتاحة</h4>
                                            <table id="job_table" class="table">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            <p class="h5 fw-bold text-center">المسمى الوظيفي</p>
                                                        </th>
                                                        <th>
                                                            <p class="h5 fw-bold text-center">مؤهلات المطلوبة</p>
                                                        </th>
                                                        <th>
                                                            <p class="h5 fw-bold text-center">مدة الخبرة</p>
                                                        </th>
                                                        <th>
                                                            <p class="h5 fw-bold text-center">مكان الوظيفة</p>
                                                        </th>
                                                        <th>
                                                            <p class="h5 fw-bold text-center">مهارات اضافية</p>
                                                        </th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="job_table_body">
                                                    <tr id="job_row_0">
                                                        <td>
                                                            <input type="text" name="job_title_0"
                                                                   id="job_title_0"
                                                                   class="py-3"
                                                            />
                                                        </td>
                                                        <td>
                                                            <input type="text" name="qualification_0"
                                                                   id="qualification_0" class="py-3"
                                                            />
                                                        </td>
                                                        <td>
                                                            <input type="text" name="experience_0"
                                                                   id="experience_0"
                                                                   class="py-3"/>
                                                        </td>
                                                        <td>
                                                            <input type="text" name="location_0"
                                                                   id="location_0"
                                                                   class="py-3"/>
                                                        </td>
                                                        <td>
                                                            <input type="text" name="extra_skills_0"
                                                                   id="extra_skills_0"
                                                                   class="py-3"/>
                                                        </td>
                                                        <td style="vertical-align:middle;padding: 0;">
                                                            <button type="button" class="remove"
                                                                    onclick="removeJobRow(0)">

                                                            </button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <button type="button" id="add_job_line" class="btn text-white">Add Line
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <button class="text-white mx-auto mt-3 btn d-block px-5 fw-bold h4"
                                        action="/MASRTECH/key_partner/registration/confirm" method="GET">
                                    Submit
                                </button>
                                </div>
                            </div>


                        </form>
                        <script><![CDATA[
                                                let trainingLineCount =$('#trainingLineCount').val();
                                                let jobLineCount = $('#jobLineCount').val();


                                                // Add line to training table
                                                document.getElementById("add_training_line").addEventListener("click", function() {
                                                trainingLineCount++;
                                                $('#trainingLineCount').val(trainingLineCount);


                                                const rowHtml = `
                                                <tr id="training_row_${trainingLineCount}">
                                                    <td>
                                                        <input type="text"
                                                               name="training_title_${trainingLineCount}"
                                                               class="py-3"
                                                        />
                                                    </td>
                                                    <td>
                                                        <input type="text" name="training_duration_${trainingLineCount}"
                                                               id="training_duration_${trainingLineCount}" class="py-3"
                                                        />
                                                    </td>
                                                    <td>
                                                        <input type="text" name="training_location_${trainingLineCount}"
                                                               id="training_location_${trainingLineCount}" class="py-3"
                                                        />
                                                    </td>
                                                    <td>
                                                        <input type="number" name="training_capacity_${trainingLineCount}"
                                                               id="training_capacity_${trainingLineCount}" class="py-3"
                                                        />
                                                    </td>
                                                    <td style="vertical-align:middle;padding: 0;">
                                                        <button type="button" class="remove"
                                                                onclick="removeTrainingRow(${trainingLineCount})">
                                                        </button>
                                                    </td>
                                                </tr>
                                                `;
                                                document.getElementById("training_table_body").insertAdjacentHTML('beforeend', rowHtml);
                                                });

                                                // Remove row from training table
                                                function removeTrainingRow(rowId) {
                                                const row = document.getElementById(`training_row_${rowId}`);
                                                if (row) {
                                                row.remove();
                                                }
                                                }

                                                // Add line to job table
                                                document.getElementById("add_job_line").addEventListener("click", function() {
                                                jobLineCount++;
                                                $('#jobLineCount').val(jobLineCount);
                                                const rowHtml = `
                                                <tr id="job_row_${jobLineCount}">
                                                    <td>
                                                        <input type="text" name="job_title_${jobLineCount}"
                                                               id="job_title_${jobLineCount}" class="py-3"/>
                                                    </td>
                                                    <td>
                                                        <input type="text" name="qualification_${jobLineCount}"
                                                               id="qualification_${jobLineCount}" class="py-3"/>
                                                    </td>
                                                    <td>
                                                        <input type="text" name="experience_${jobLineCount}"
                                                               id="experience_${jobLineCount}"
                                                               class="py-3"/>
                                                    </td>
                                                    <td>
                                                        <input type="text" name="location_${jobLineCount}"
                                                               id="location_${jobLineCount}"
                                                               class="py-3"/>
                                                    </td>
                                                    <td>
                                                        <input type="text" name="extra_skills_${jobLineCount}"
                                                               id="extra_skills_${jobLineCount}"
                                                               class="py-3"/>
                                                    </td>
                                                    <td style="vertical-align:middle;padding: 0;">
                                                        <button type="button" class="remove"
                                                                onclick="removeJobRow(${jobLineCount})">

                                                        </button>
                                                    </td>
                                                </tr>
                                                `;
                                                document.getElementById("job_table_body").insertAdjacentHTML('beforeend', rowHtml);
                                                });

                                                // Remove row from job table
                                                function removeJobRow(rowId) {
                                                const row = document.getElementById(`job_row_${rowId}`);
                                                if (row) {
                                                row.remove();
                                                }
                                                }
                                                ]]>
                        </script>
                    </body>
                </div>
            </t>
        </template>
        <template id="key_partner_registration_confirm">
            <t t-call="website.layout">
                <div id="wrap">
                    <head>

                    </head>
                    <body>
                        <div class="text-center col-12 col-md-7 mx-auto">
                            <div style="border: solid 2px #0060bf; border: solid 2px #0060bf;margin: 20px 50px;padding: 40px; border-radius: 20px;">
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="width: 240px;">
                                            <h5 style="font-size: 25px; color: #0060bf;">
                                                The registration is confirmed
                                            </h5>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </body>
                </div>
            </t>
        </template>
    </data>
</odoo>

