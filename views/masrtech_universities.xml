<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="masrtech_universities_kanban_view">
            <field name="name">universities_kanban</field>
            <field name="model">masrtech.universities</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" action="action_masrtech_colleges" type="object" sample="1">
                    <field name="name"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <ul>
                                        Name :
                                        <field name="name"/>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.ui.view" id="masrtech_Universities_form_view">
            <field name="model">masrtech.universities</field>
            <field name="arch" type="xml">
                <form string="Universities">
                    <sheet>
                         <style>
                            .o_form_sheet.position-relative{
                            width: 90%;
                            margin: 0 auto;
                            padding: 35px 40px;
                            margin-top: 26px;
                            }
                        </style>
                         <group col="4" colspan="4">
                            <group class="w-50">
                            <field name="name"/>
                            <field name="university_name_ar"/>
                            </group>
                             <group class="w-50">
                            <field name="faculty" widget="many2many_tags"/>
                        </group>
                         </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="masrtech_universities_tree_view">
            <field name="model">masrtech.universities</field>
            <field name="arch" type="xml">
                <tree string="Universities">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="action_masrtech_Universities" model="ir.actions.act_window">
            <field name="name">Universities</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">masrtech.universities</field>
            <field name="view_mode">kanban,tree,form,search</field>
        </record>

    </data>
</odoo>