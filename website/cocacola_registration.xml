<odoo>
    <data>
        <template id="registration_for_cocacola">
            <t t-call="website.layout">
                <div id="wrap">
                    <head>
                        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css"
                              rel="stylesheet"/>
                        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"/>
                        <title>Coca-cola Registration</title>
                        <style>
                            footer{
                            display: none;
                            }
                        </style>
                    </head>
                    <body>

                        <div class="row g-0">
                            <div class="col-lg-8 d-none d-lg-block">
                                <img src="/nexus_nms/static/src/images/bg-cocacola.webp" class="w-100 h-100"/>
                            </div>
                            <div class="col-lg-4 p-4">
                                <div class="col-8 mx-auto row">
                                    <div class="col-md-6 d-flex align-items-center">
                                        <img src="/nexus_nms/static/src/images/cocacolaLogo.webp" class="w-100"/>
                                    </div>
                                    <div class="col-md-6 d-flex align-items-center">
                                        <img src="/nexus_nms/static/src/images/universityLogo.png" class="ms-2 w-100"/>
                                    </div>
                                </div>
                                <div>
                                    <h3 class=" mt-4 text-center text-uppercase mb-2">
                                        <span class="fw-bold ">Sign up</span>
                                        <br/>To Your Account
                                    </h3>
                                </div>
                                <t t-if="error_message">
                                    <div class="alert alert-warning alert-dismissible fade show mt-3 mb-3" role="alert">
                                        <i class="fas fa-exclamation-triangle"></i>
                                        <strong>Warning!</strong>
                                        <t t-esc="error_message"/>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"
                                                aria-label="Close"></button>
                                    </div>
                                </t>
                                <form action="/cocacola/submit" method="POST" role="form"
                                      class="form-container col-md-8 mx-auto"
                                      id="registrationFormCocacola">
                                    <label for="email" class="my-2 text-black fw-bold fs-6">Enter Your Email</label>
                                    <input type="text" name="email" id="email" t-att-value="email"
                                           placeholder="Enter Your Email"
                                           class="d-block form-control"/>

                                    <label for="name" class="my-2 text-black fw-bold fs-6">Enter Your Name</label>
                                    <input type="text" name="name" id="name" t-att-value="name"
                                           placeholder="Enter Your Name"
                                           class="d-block form-control"/>
                                    <label for="phone" class="my-2 text-black fw-bold fs-6">Enter Your Phone / Whatsapp
                                    </label>
                                    <input type="tel" name="phone" id="phone" t-att-value="phone"
                                           placeholder="Enter Your Phone / Whatsapp" class="d-block form-control"/>

                                    <label for="university" class="my-2 text-black fw-bold fs-6">University</label>
                                    <select class="form-select" name="university" id="university" required="1">
                                        <option value="">Select university</option>
                                        <t t-foreach="universities" t-as="university">
                                            <option t-att-value="university.id">
                                                <t t-esc="university.name"/>
                                            </option>
                                        </t>
                                    </select>
                                    <label for="courses" class="my-2 text-black fw-bold fs-6">Courses</label>
                                    <div class="alert "
                                         style="background-color: #e1efff; border-color: #e1efff; color: #3d316b;">
                                        <ul class="mb-0">
                                            <li>
                                                <p class="fs-6 mb-0">
                                                    <strong>
                                                        Data Analysis
                                                    </strong>
                                                    (10/10/2025)
                                                </p>
                                            </li>
                                            <li>
                                                <p class="fs-6 mb-0">
                                                    <strong>
                                                        Sales
                                                    </strong>
                                                    (11/10/2025)
                                                </p>
                                            </li>
                                        </ul>


                                    </div>
                                    <div class="alert alert-danger mt-3">
                                        <h5 class="fw-bold">
                                            Important Note
                                        </h5>
                                        <p>
                                           The amount is 200 for the accredited certificates.
                                        </p>
                                    </div>
                                    <label for="gender" class="my-2 text-black fw-bold fs-6">Gender</label>
                                    <div class="d-flex">
                                        <div class="p-2 border w-50">
                                            <input type="radio" name="gender" id="male" value="male"/>
                                            <label for="male" class="my-2 text-black fw-bold fs-6">Male</label>
                                        </div>
                                        <div class="p-2 border w-50">
                                            <input type="radio" name="gender" id="female" value="female"/>
                                            <label for="female" class="my-2 text-black fw-bold fs-6">Female</label>
                                        </div>
                                    </div>
                                    <label for="age" class="my-2 text-black fw-bold fs-6">Enter Your Age
                                    </label>
                                    <input type="number" name="age" id="age" t-att-value="age"
                                           placeholder="Enter Your Age" class="d-block form-control"/>
                                    <label for="national_id" class="my-2 text-black fw-bold fs-6">Enter Your National ID
                                    </label>
                                    <input type="number" name="national_id" id="national_id" t-att-value="national_id"
                                           placeholder="Enter Your National ID" class="d-block form-control"/>
                                    <label for="password" class="my-2 text-black fw-bold fs-6">Enter Your Password
                                    </label>
                                    <input type="password" name="password" id="password"
                                           placeholder="Enter Your Password" class="d-block form-control"/>
                                    <label for="confirm_password" class="my-2 text-black fw-bold fs-6">Confirm Your
                                        Password
                                    </label>
                                    <input type="password" name="confirm_password" id="confirm_password"
                                           placeholder="Confirm Your Password" class="d-block form-control"/>
                                    <button class="btn btn-danger w-100 mt-4">Sign Up</button>
                                    <!--                                    <div class="mt-3 fs-5">-->
                                    <!--                                        Have an account?-->
                                    <!--                                        <a href="#" class="text-danger">Sign in</a>-->
                                    <!--                                    </div>-->
                                </form>
                            </div>
                        </div>
                    </body>
                </div>
            </t>
        </template>
