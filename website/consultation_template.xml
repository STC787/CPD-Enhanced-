<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="consultation_template">
            <t t-call="website.layout">
                <div id="wrap">
                    <head>
                        <style>
                            * {
                            margin: 0;
                            padding: 0;
                            box-sizing: border-box;
                            }

                            body {
                            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                            }

                            .custom-container {
                            max-width: 1300px;
                            background: white;
                            border-radius: 20px;
                            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
                            overflow: hidden;
                            }

                            .header {
                            background: linear-gradient(135deg, #36d1dc, #5b86e5);
                            color: white;
                            text-align: center;
                            padding: 30px;
                            font-size: 28px;
                            font-weight: bold;
                            position: relative;
                            }

                            .header::before {
                            content: '';
                            position: absolute;
                            top: 0;
                            left: 0;
                            right: 0;
                            bottom: 0;
                            background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 100%);
                            }

                            .form-container {
                            padding: 40px;
                            }

                            .section {
                            background: linear-gradient(135deg, #4fc3f7, #29b6f6);
                            color: white;
                            padding: 15px 25px;
                            margin: 0 -40px 30px -40px;
                            font-weight: bold;
                            font-size: 18px;
                            position: relative;
                            }

                            .section::before {
                            content: '';
                            position: absolute;
                            top: 0;
                            left: 0;
                            right: 0;
                            bottom: 0;
                            background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 100%);
                            }

                            .form-row {
                            display: flex;
                            gap: 20px;
                            margin-bottom: 25px;
                            flex-wrap: wrap;
                            }

                            .form-group {
                            flex: 1;
                            min-width: 250px;
                            }

                            .form-group.full-width {
                            flex: 100%;
                            }

                            label {
                            display: block;
                            margin-bottom: 8px;
                            font-weight: 600;
                            color: #333;
                            font-size: 14px;
                            }

                            .required {
                            color: #f44336;
                            }

                            input[type="text"],
                            input[type="email"],
                            input[type="tel"],
                            input[type="date"],
                            select,
                            textarea {
                            width: 100%;
                            padding: 12px 16px;
                            border: 2px solid #e0e0e0;
                            border-radius: 8px;
                            font-size: 14px;
                            transition: all 0.3s ease;
                            background: white;
                            }

                            input[type="text"]:focus,
                            input[type="email"]:focus,
                            input[type="tel"]:focus,
                            input[type="date"]:focus,
                            select:focus,
                            textarea:focus {
                            outline: none;
                            border-color: #00bcd4;
                            box-shadow: 0 0 0 3px rgba(0, 188, 212, 0.1);
                            transform: translateY(-2px);
                            }

                            textarea {
                            resize: vertical;
                            min-height: 100px;
                            }

                            select {
                            cursor: pointer;
                            }

                            .file-input-wrapper {
                            position: relative;
                            display: inline-block;
                            width: 100%;
                            }

                            .file-input {
                            position: absolute;
                            opacity: 0;
                            width: 100%;
                            height: 100%;
                            cursor: pointer;
                            }

                            .file-input-display {
                            padding: 12px 16px;
                            border: 2px dashed #e0e0e0;
                            border-radius: 8px;
                            text-align: center;
                            color: #666;
                            cursor: pointer;
                            transition: all 0.3s ease;
                            }

                            .file-input-display:hover {
                            border-color: #00bcd4;
                            background: rgba(0, 188, 212, 0.05);
                            }

                            .submit-btn {
                            background: linear-gradient(135deg, #36d1dc, #5b86e5);
                            color: white;
                            border: none;
                            padding: 15px 40px;
                            font-size: 16px;
                            font-weight: bold;
                            border-radius: 25px;
                            cursor: pointer;
                            transition: all 0.3s ease;
                            display: block;
                            margin: 40px auto 0;
                            box-shadow: 0 4px 15px rgba(0, 188, 212, 0.3);
                            }

                            .submit-btn:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 8px 25px rgba(0, 188, 212, 0.4);
                            }

                            .submit-btn:active {
                            transform: translateY(0);
                            }

                            @media (max-width: 768px) {
                            .form-row {
                            flex-direction: column;
                            }

                            .form-group {
                            min-width: 100%;
                            }

                            .form-container {
                            padding: 20px;
                            }

                            .section {
                            margin: 0 -20px 20px -20px;
                            }
                            }
                        </style>
                    </head>
                    <body>
                        <!--                        <div class="mt-3">-->
                        <!--                              <img src="/nexus_nms/static/src/images/nexusLogo.png" width="200"-->
                        <!--                                 style="margin: auto; display: block;"/>-->
                        <!--                        </div>-->
                        <div class="container p-0 my-4 custom-container">
                            <div class="header">
                                Request Consultation
                            </div>

                            <div class="form-container">
                                <form role="form" action="/consultation/form/confirm" method="GET"
                                  enctype="multipart/form-data">
                                    <div class="section">
                                        Personal Information
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="name">Full Name
                                                <span class="required">*</span>
                                            </label>
                                            <input type="text" id="name" name="name" required="1"/>
                                        </div>
                                        <div class="form-group">
                                            <label for="email">Email Address
                                                <span class="required">*</span>
                                            </label>
                                            <input type="email" id="email" name="email" required="1"/>
                                        </div>
                                        <div class="form-group">
                                            <label for="phone">Phone Number:</label>
                                            <input type="text" id="phone" name="phone"/>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="company">Organization / Company:</label>
                                            <input type="text" id="company" name="company"/>
                                        </div>
                                        <div class="form-group">
                                            <label for="sector">Sector:</label>
                                            <select id="sector" name="sector">
                                                <option value="">-- Select --</option>
                                               <t t-foreach="sector" t-as="sector">
                                                    <option t-esc="sector.name" t-att-value="sector.id"
                                                            t-att-selected="str(sector.id) == sector">
                                                        <t t-esc="sector.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="consulting_type">Type of Consultation:
                                                <span class="required">*</span>
                                            </label>
                                            <select id="consulting_type" name="consulting_type" required="1">
                                                <option value="">-- Select --</option>
                                                  <option value="Industrial">Industrial</option>
                                                <option value="Healthcare">Healthcare</option>
                                                <option value="Academic">Academic</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="section">
                                        Consultation Details
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="consultation_topic">Consultation Topic</label>
                                            <textarea id="consultation_topic" name="consultation_topic"></textarea>
                                        </div>
                                        <div class="form-group">
                                            <label for="consultation_details">Consultation Details</label>
                                            <textarea id="consultation_details" name="consultation_details"></textarea>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="contact_method">Preferred Contact Method</label>
                                            <select id="contact_method" name="contact_method">
                                                <option value="">-- Select --</option>
                                                <option value="email">Email</option>
                                                <option value="phone">Phone</option>
                                                <option value="video">Video Call</option>
                                                <option value="inPerson">In Person</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                             <label for="availability" >Availability
                                                <span style="color: #29abe2;">(Days/Times)</span>
                                            </label>
                                            <input type="text" id="availability" name="availability"
                                                   placeholder="e.g. Mon-Fri, 10am - 4pm"/>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="start_date">Preferred Start Date</label>
                                            <input type="date" id="start_date" name="start_date"/>
                                        </div>
                                        <div class="form-group">
                                            <label for="message">Project Description / Requirements
                                                <span class="required">*</span>
                                            </label>
                                            <textarea id="message" name="message"
                                                      required="1"></textarea>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="attachment">Attach Files (optional)</label>
                                            <div class="file-input-wrapper">
                                                <input type="file" id="attachment" name="attachment"
                                                       class="file-input" multiple="1"/>
                                                <div class="file-input-display">
                                                    Choose Files - No file chosen
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="first_consult">Is this your first consultation with us?
                                            </label>
                                            <select id="first_consult" name="first_consult">
                                                <option value="">-- Select --</option>
                                                <option value="yes">Yes</option>
                                                <option value="no">No</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group full-width">
                                            <label for="add_notes">Additional Notes</label>
                                            <textarea id="add_notes" name="add_notes"></textarea>
                                        </div>
                                    </div>

                                    <button type="submit" class="submit-btn"  action="/consultation/form/confirm" method="GET">REQUEST</button>
                                </form>
                            </div>
                        </div>

                        <script>
                            // File input display update
                            document.getElementById('attachFiles').addEventListener('change', function(e) {
                            const display = document.querySelector('.file-input-display');
                            const files = e.target.files;
                            if (files.length > 0) {
                            if (files.length === 1) {
                            display.textContent = files[0].name;
                            } else {
                            display.textContent = `${files.length} files selected`;
                            }
                            } else {
                            display.textContent = 'Choose Files - No file chosen';
                            }
                            });

                            // Form submission
                            document.querySelector('form').addEventListener('submit', function(e) {
                            e.preventDefault();
                            alert('Form submitted successfully!');
                            });
                        </script>
                    </body>

                </div>
            </t>
        </template>
        <template id="consultation_template_confirm">
            <t t-call="website.layout">
                <div id="wrap">
                    <head>

                    </head>
                    <body>
                        <div class="text-center col-12 col-md-7 mx-auto">
                            <div style="border: solid 2px #0060bf; border: solid 2px #0060bf;margin: 20px 50px;padding: 40px; border-radius: 20px;">
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="width: 240px;">
                                            <h5 style="font-size: 25px; color: #0060bf;">
                                                The registration is confirmed
                                            </h5>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </body>
                </div>
            </t>
        </template>

    </data>
</odoo>