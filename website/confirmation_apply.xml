<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="confirmation_apply">
            <t t-call="website.layout">
                <div id="wrap">
                    <head>
                        <style>
                            * {
                            margin: 0;
                            padding: 0;
                            box-sizing: border-box;
                            }

                            body {
                            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu,
                            Cantarell, sans-serif;
                            background-color: #f8f9fa;
                            line-height: 1.6;
                            color: #333;
                            }

                            .confirm {
                            max-width: 800px;
                            margin: 0 auto;
                            padding: 40px 20px;
                            background-color: white;
                            min-height: 100vh;
                            }

                            .breadcrumb-nav {
                            font-size: 14px;
                            color: #4f4f4f;
                            margin-bottom: 30px;
                            font-weight: bold;
                            }

                            .breadcrumb-nav span {
                            margin: 0 8px;
                            }

                            .main-heading {
                            font-size: 32px;
                            font-weight: 600;
                            color: #4a90e2;
                            margin-bottom: 20px;
                            }

                            .description {
                            font-size: 16px;
                            color: #6c757d;
                            margin-bottom: 40px;
                            line-height: 1.5;
                            }

                            .next-steps {
                            background-color: #f8f9fa;
                            border-radius: 8px;
                            padding: 30px;
                            margin-bottom: 40px;
                            }

                            .next-steps-header {
                            display: flex;
                            align-items: center;
                            margin-bottom: 15px;
                            }

                            .checkmark {
                            width: 24px;
                            height: 24px;
                            background-color: #4a90e2;
                            border-radius: 50%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            margin-right: 15px;
                            flex-shrink: 0;
                            }

                            .checkmark::after {
                            content: "✓";
                            color: white;
                            font-weight: bold;
                            font-size: 14px;
                            }

                            .next-steps h2 {
                            font-size: 20px;
                            font-weight: 600;
                            color: #333;
                            margin: 0;
                            }

                            .next-steps-description {
                            font-size: 14px;
                            color: #6c757d;
                            line-height: 1.5;
                            }

                            .button-group {
                            display: flex;
                            gap: 15px;
                            margin-bottom: 40px;
                            flex-wrap: wrap;
                            }

                            .btn-confirm {
                            padding: 12px 24px !important;
                            border: none !important;
                            border-radius: 8px !important;
                            font-size: 14px !important;
                            font-weight: 500 !important;
                            cursor: pointer !important;
                            text-decoration: none !important;
                            display: inline-block !important;
                            transition: all 0.2s ease !important;
                            }

                            .backBtn {
                            background-color: #4a90e2 !important;
                            color: white !important;
                            }

                            .backBtn:hover {
                            background-color: #357abd !important;
                            }

                            .contactbtn {
                            background-color: #5293d140 !important;
                            color: #4a90e2 !important;
                            }

                            .contactbtn:hover {
                            background-color: #e9f2fb !important;
                            }

                            .contact-info {
                            font-size: 14px;
                            color: #6c757d;
                            }

                            .contact-info a {
                            color: #4a90e2;
                            text-decoration: none;
                            }

                            .contact-info a:hover {
                            text-decoration: underline;
                            }

                            @media (max-width: 600px) {
                            .confirm {
                            padding: 20px 15px;
                            }

                            .main-heading {
                            font-size: 24px;
                            }

                            .button-group {
                            flex-direction: column;
                            }

                            .btn {
                            text-align: center;
                            }
                            }
                        </style>
                    </head>
                    <body>

                        <div class="container-fluid confirm">


                            <h1 class="main-heading">Thank You for Applying!</h1>

                            <p class="description">
                                Your application for the Health-Tech IT Summer Field Training has been received. We'll
                                review your details and contact you soon with next steps.
                            </p>

                            <div class="next-steps">
                                <div class="next-steps-header">
                                    <div class="checkmark"></div>
                                    <h2>What's Next?</h2>
                                </div>
                                <p class="next-steps-description">
                                    Our team will review your application. If selected, you'll receive an email with
                                    further
                                    instructions and program details.
                                </p>
                            </div>

                            <div class="button-group">
                                <a href="/program_details" class="btn-confirm backBtn">Back to Flyer</a>
                                <a href="/contact_us" class="btn-confirm contactbtn">Contact Support</a>
                            </div>

                            <p class="contact-info">
                                Questions? Email
                                <a href="mailto:info@georgelarab.edu.eg">info@georgelarab.edu.eg</a>
                            </p>
                        </div>
                    </body>
                </div>
            </t>
        </template>


    </data>
</odoo>