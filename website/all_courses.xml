                    <script><![CDATA[
// Spinner functionality
document.addEventListener('DOMContentLoaded', function() {
  // Get the spinner element
  const spinner = document.getElementById('spinner');

  // Make sure the spinner is visible during initial page load
  if (spinner) {
    spinner.classList.add('show');
  }

  // Hide spinner when everything is fully loaded
  window.addEventListener('load', function() {
    // Small delay to ensure everything is rendered
    setTimeout(function() {
      // Remove the "show" class to trigger the CSS transition
      if (spinner) {
        spinner.classList.remove('show');
      }

      // Dispatch a custom event when spinner is hidden
      setTimeout(function() {
        // Create and dispatch custom event after spinner transition completes
        const spinnerCompleteEvent = new CustomEvent('spinnerComplete');
        document.dispatchEvent(spinnerCompleteEvent);
      }, 500); // Match the spinner transition time

    }, 800); // Slightly longer delay to appreciate the overlay
  });
});

