<odoo>
    <data>
        <template id="student_registration">
            <t t-call="website.layout">
                <div id="wrap">
                    <head>
                        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css"
                              rel="stylesheet"/>
                        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"/>
                        <title>Student Registration</title>
                        <style>


                            * {
                            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                            }
                            body {
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            }
                            .form-container {
                            max-width: 1300px;
                            margin: 0 auto;
                            background: white;
                            border-radius: 20px;
                            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
                            overflow: hidden;
                            }

                            .form-header {
                            background: linear-gradient(135deg, #36d1dc, #5b86e5);
                            color: white;
                            text-align: center;
                            padding: 30px;
                            position: relative;
                            }

                            .form-header::before {
                            content: '';
                            position: absolute;
                            bottom: -2px;
                            left: 0;
                            right: 0;
                            height: 20px;
                            background: white;
                            border-radius: 20px 20px 0 0;
                            }

                            .form-header h1 {
                            color:white;
                            margin: 0;
                            font-size: 2.5rem;
                            font-weight: 700;
                            }

                            .form-body {
                            padding: 40px;
                            }

                            .section-header {
                            background: linear-gradient(90deg, #e3f2fd 0%, #bbdefb 100%);
                            border-radius: 12px;
                            padding: 15px 20px;
                            margin: 30px 0 20px 0;
                            border-right: 4px solid #2196f3;
                            display: flex;
                            align-items: center;
                            gap: 10px;
                            }

                            .section-header i {
                            color: #2196f3;
                            font-size: 1.2rem;
                            }

                            .section-header h3 {
                            margin: 0;
                            color: #1976d2;
                            font-weight: 600;
                            font-size: 1.3rem;
                            }

                            .form-group {
                            margin-bottom: 25px;
                            }

                            .form-group label {
                            display: block;
                            margin-bottom: 8px;
                            font-weight: 600;
                            color: #333;
                            font-size: 0.95rem;
                            }

                            .form-control, .form-select {
                            border: 2px solid #e0e0e0;
                            border-radius: 12px;
                            padding: 12px 16px;
                            font-size: 1rem;
                            transition: all 0.3s ease;
                            background: #fafafa;
                            }

                            .form-control:focus, .form-select:focus {
                            border-color: #4facfe;
                            box-shadow: 0 0 0 0.2rem rgba(79, 172, 254, 0.25);
                            background: white;
                            }

                            .row-custom {
                            display: grid;
                            grid-template-columns: 1fr 1fr;
                            gap: 30px;
                            margin-bottom: 20px;
                            }

                            @media (max-width: 768px) {
                            .row-custom {
                            grid-template-columns: 1fr;
                            gap: 20px;
                            }
                            }

                            .file-upload-section {
                            background: #f8f9fa;
                            border: 2px dashed #dee2e6;
                            border-radius: 12px;
                            padding: 30px;
                            text-align: center;
                            margin: 30px 0;
                            transition: all 0.3s ease;
                            }

                            .file-upload-section:hover {
                            border-color: #4facfe;
                            background: #f0f8ff;
                            }

                            .file-upload-section i {
                            font-size: 3rem;
                            color: #6c757d;
                            margin-bottom: 15px;
                            }

                            .btn-submit {
                            background: linear-gradient(135deg, #36d1dc, #5b86e5);
                            border: none;
                            border-radius: 50px;
                            padding: 15px 50px;
                            font-size: 1.1rem;
                            font-weight: 600;
                            color: white;
                            cursor: pointer;
                            transition: all 0.3s ease;
                            text-transform: uppercase;
                            letter-spacing: 1px;
                            margin-top: 30px;
                            display: block;
                            margin-left: auto;
                            margin-right: auto;
                            }

                            .btn-submit:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 10px 30px rgba(79, 172, 254, 0.4);
                            }

                            .required {
                            color: #e74c3c;
                            }

                            .account-section {
                            background:#49a3ed;
                            color: white;
                            padding: 30px;
                            border-radius: 15px;
                            margin-bottom: 30px;
                            }

                            .account-section h3 {
                            color: white;
                            margin-bottom: 25px;
                            font-weight: 600;
                            }

                            .account-section .form-control {
                            background: rgba(255, 255, 255, 0.9);
                            border: none;
                            color: #333;
                            }

                            .account-section .form-control:focus {
                            background: white;
                            box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25);
                            }

                            .account-section label {
                            color: white;
                            font-weight: 500;
                            }


                            .required-star {
                            color: #e74c3c;
                            margin-right: 3px;
                            }

                        </style>
                    </head>
                    <body>
                        <div class="container my-4">

                            <form style="direction: rtl;" role="form" action="/studentRegisConfirm" method="POST"
                                  class="form-container" enctype="multipart/form-data">

                                <div class="form-header">
                                    <h1><i class="fas fa-graduation-cap ms-2"></i>التسجيل
                                    </h1>
                                    <h3 class="text-white">طالب / خريج</h3>
                                </div>

                                <div class="form-body">
                                    <div class="error_container d-flex w-100 justify-content-center fs-5 mb-5"
                                         dir="rtl">
                                        <t t-if="error_message">
                                            <div class="error-alert  border border-warning border-2 rounded-2 p-3"
                                                 style="box-shadow: 3px 3px #ffc107;">
                                                <div>
                                                    <i class="fas fa-exclamation-triangle text-warning"></i>
                                                    <strong>خطأ:</strong>
                                                </div>
                                                <div>
                                                    <span t-esc="error_message"/>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <!-- Account Creation Section -->
                                    <div class="account-section">
                                        <h3><i class="fas fa-user-plus ms-3"></i>انشاء حساب جديد
                                        </h3>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label for="portal_name">اسم الحساب
                                                        <span class="required-star">*</span>
                                                    </label>
                                                    <input type="text" name="portal_name" class="form-control"
                                                           required="required"/>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label for="email">ايميل الحساب
                                                        <span class="required-star">*</span>
                                                    </label>
                                                    <input type="username" name="username" class="form-control"
                                                           required="required"/>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label for="pass">كلمة مرور
                                                        <span class="required-star">*</span>
                                                    </label>
                                                    <input type="password" name="password" class="form-control"
                                                           required="required"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Personal Information Section -->
                                    <div class="section-header">
                                        <i class="fas fa-user"></i>
                                        <h3>المعلومات الشخصية</h3>
                                    </div>

                                    <div class="row-custom">
                                        <div class="form-group">
                                            <label for="name">اسم الطالب / الخريج
                                                <span class="required-star">*</span>
                                            </label>
                                            <input type="text" id="name" name="name" required="1" placeholder="اجابتك"
                                                   class="form-control"/>
                                        </div>


                                        <div class="row-custom">
                                            <div class="form-group">
                                                <label for="email">البريد الالكتروني
                                                    <span class="required-star">*</span>
                                                </label>
                                                <input type="email" id="email" name="email" required="1"
                                                       placeholder="اجابتك" class="form-control"/>
                                            </div>
                                            <div class="form-group">
                                                <label for="phone">رقم الهاتف
                                                    <span class="required-star">*</span>
                                                </label>
                                                <input type="tel" id="phone" name="phone" required="1"
                                                       placeholder="اجابتك"
                                                       class="form-control" dir="rtl"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Academic Information Section -->
                                    <div class="section-header">
                                        <i class="fas fa-graduation-cap"></i>
                                        <h3>المعلومات الاكاديمية</h3>
                                    </div>

                                    <div class="row-custom">
                                        <div class="form-group">
                                            <label for="academic_track">المسار الاكاديمي
                                                <span class="required-star">*</span>
                                            </label>
                                            <select name="academic_track" id="academic_track" required="1"
                                                    class="form-select">
                                                <option value="">اختر المسار</option>
                                                <option value="student">طالب</option>
                                                <option value="graduated">خريج</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="levels">الفرقة</label>
                                            <select id="levels" name="levels" class="form-select">
                                                <option value="">اختر الفرقة</option>
                                                <option value="one">الاولي</option>
                                                <option value="two">الثانية</option>
                                                <option value="three">الثالثة</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row-custom">
                                        <div class="form-group">
                                            <label for="university">الجامعة</label>
                                            <select class="form-select" name="university" id="university" required="1">
                                                <option value="">اختر الجامعة</option>
                                                <t t-foreach="universities" t-as="university">
                                                    <option t-att-value="university.id">
                                                        <t t-esc="university.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="faculty">الكلية</label>
                                            <select class="form-select" name="faculty" id="faculty">
                                                <option value="">اختر الكلية</option>
                                                <t t-foreach="faculty" t-as="faculty">
                                                    <option t-esc="faculty.name" t-att-value="faculty.id"
                                                            t-att-selected="str(faculty.id) == faculty">
                                                        <t t-esc="faculty.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="faculty_id">رقم الجامعى
                                                <span class="required-star">*</span>
                                            </label>
                                            <input type="text" id="faculty_id" name="faculty_id" required="1"
                                                   placeholder="اجابتك"
                                                   class="form-control"/>
                                        </div>
                                        <div class="form-group">
                                            <label for="department">البرنامج
                                                <span class="required">*</span>
                                            </label>
                                            <select class="form-select" name="department" id="department" required="1">
                                                <option value="">اختر البرنامج</option>
                                                <t t-foreach="department" t-as="department">
                                                    <option t-esc="department.name" t-att-value="department.id"
                                                            t-att-selected="str(department.id) == department">
                                                        <t t-esc="department.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    <!-- Document Upload Section -->
                                    <div class="section-header">
                                        <i class="fas fa-upload"></i>
                                        <h3>رفع المستندات</h3>
                                    </div>

                                    <div class="file-upload-section">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                        <h4>برجاء ارفاق الشهادات التي حصلت عليها</h4>
                                        <p class="text-muted mb-3">يمكنك رفع ملفات متعددة</p>
                                        <input type="file" id="fileUpload" name="fileUpload" multiple="multiple"
                                               class="form-control"/>
                                    </div>

                                    <button type="submit" class="btn-submit" action="/studentRegisConfirm"
                                            method="POST">
                                        <i class="fas fa-paper-plane me-2"></i>
                                        تسجيل
                                    </button>
                                </div>
                            </form>
                        </div>
                    </body>
                </div>
            </t>
        </template>
        <template id="student_registration_confirm">
            <t t-call="website.layout">
                <div id="wrap">
                    <head>
                    </head>
                    <body>
                        <div class="text-center col-12 col-md-7 mx-auto">
                            <div style="border: solid 2px #0060bf; margin: 20px 50px; padding: 40px; border-radius: 20px;">
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="width: 240px;">
                                            <h5 style="font-size: 25px; color: #0060bf;">
                                                The registration is confirmed
                                            </h5>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Username is shown; the password is never rendered on the page -->
                                <div class="mt-4" style="text-align: left;">
                                    <h6 style="color: #0060bf;">Your login username:</h6>
                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <p>
                                                <strong>Username:</strong>
                                                <span t-esc="username"/>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="alert alert-warning mt-3">
                                        <i class="fa fa-exclamation-triangle"/>
                                        Your password is set during registration and is kept private.
                                        You can now login with your username from the login page.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </body>
                </div>
            </t>
        </template>
    </data>
</odoo>


