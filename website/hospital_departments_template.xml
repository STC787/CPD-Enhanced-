<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="hospital_departments_template">
            <t t-call="website.layout">
                <div id="wrap">
                    <style>
                        h1{
                        color: #3F82EB;
                        }
                        .icon{
                        background: #D7DCFF;
                        border-radius: 8px;
                        }
                        .icon img{
                        width: 30px;
                        }
                    </style>
                    <body>
                        <div class="container col-md-6 mt-5">
                            <p class="fw-bold">
                                <a href="/all_programs" class="breadcrumb-link">Flyer</a>
                                <span class="breadcrumb-separator"> > </span>
                                <a t-attf-href="" class="breadcrumb-link">What You'll Learn</a>
                                <span class="breadcrumb-separator"> > </span>
                                <span class="breadcrumb-current">Hospital Departments</span>
                            </p>
                            <h1 class="fw-bold">Hospital Departments</h1>
                            <p class="my-3">See how patients move through key hospital departments and how IT supports
                                each step.
                            </p>
                            <section>
                                <h4 class="fw-bold">Patient Flow Map</h4>
                                <div class="" style="height: 500px;">
                                    <img src="/nexus_nms/static/src/images/hospital_department.jpeg" class="w-100 h-100"
                                         style="border-radius: 8px; object-fit: cover;"/>
                                </div>
                            </section>
                            <section class="my-4">
                                <h4 class="fw-bold mb-3">Key Departments</h4>
                               <div class="row">
                                   <div class="col-md-6 d-flex flex-column gap-4">
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/reception.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">Reception </h5>
                                               <p class="mb-0"> Patient check-in &amp; records</p>
                                           </div>
                                       </div>
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/consultation.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">Consultation</h5>
                                               <p class="mb-0">Doctor evaluation</p>
                                           </div>
                                       </div>
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/treatment.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">Treatment</h5>
                                               <p class="mb-0">Procedures &amp; care</p>
                                           </div>
                                       </div>
                                   </div>
                                   <div class="col-md-6 d-flex flex-column gap-4">
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/triage.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">Triage  </h5>
                                               <p class="mb-0"> Initial assessment</p>
                                           </div>
                                       </div>
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/diagnostics.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">Diagnostics  </h5>
                                               <p class="mb-0"> Lab &amp; Imaging</p>
                                           </div>
                                       </div>
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/discharge.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">Discharge  </h5>
                                               <p class="mb-0">  Patient exit &amp; follow-up</p>
                                           </div>
                                       </div>
                                   </div>
                               </div>
                            </section>
                            <section class="my-4">
                                <h4 class="fw-bold mb-3">IT Touchpoints</h4>
                               <div class="row">
                                   <div class="col-md-6 d-flex flex-column gap-4">
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/ehr-access.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">EHR Access </h5>
                                               <p class="mb-0"> Digital patient records</p>
                                           </div>
                                       </div>
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/imaging.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">Imaging </h5>
                                               <p class="mb-0">Radiology &amp; scans</p>
                                           </div>
                                       </div>
                                   </div>
                                   <div class="col-md-6 d-flex flex-column gap-4">
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/lab-systems.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">Lab Systems  </h5>
                                               <p class="mb-0"> Test results integration</p>
                                           </div>
                                       </div>
                                       <div class="d-flex gap-3 align-items-center">
                                           <div class="p-2 icon">
                                               <img src="/nexus_nms/static/src/images/analytics.svg"/>
                                           </div>
                                           <div>
                                               <h5 class="fw-bold mb-0">Analytics   </h5>
                                               <p class="mb-0">  Patient flow Insights</p>
                                           </div>
                                       </div>
                                   </div>
                               </div>
                            </section>
                        </div>
                    </body>

                </div>
            </t>
        </template>


    </data>
</odoo>